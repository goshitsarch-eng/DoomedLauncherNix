set(source_dir "@CMAKE_SOURCE_DIR@")
set(expected_version "@PROJECT_VERSION@")

function(assert_contains relative_path expected)
    file(READ "${source_dir}/${relative_path}" contents)
    string(FIND "${contents}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${relative_path} does not contain: ${expected}")
    endif()
endfunction()

assert_contains("CMakeLists.txt" "project(DoomedLauncher VERSION ${expected_version}")
assert_contains("src/main.cpp" "QStringLiteral(DOOMEDLAUNCHER_VERSION)")
assert_contains("src/main.cpp" "setOrganizationName(QStringLiteral(\"Gosh\"))")
assert_contains("src/main.cpp" "about.addAuthor(i18n(\"Gosh\"))")
assert_contains("data/com.goshapps.DoomLauncher.metainfo.xml" "<name>Gosh</name>")
assert_contains("data/com.goshapps.DoomLauncher.metainfo.xml" "<release version=\"${expected_version}\"")
assert_contains("README.md" "Current release: **${expected_version}**")
assert_contains("RELEASENOTES.md" "## ${expected_version}")
assert_contains("flatpak/com.goshapps.DoomLauncher.yml" "runtime-version: '6.10'")

file(READ "${source_dir}/src/main.cpp" main_source)
file(READ "${source_dir}/data/com.goshapps.DoomLauncher.metainfo.xml" appstream_source)
if(main_source MATCHES "Vaughan" OR appstream_source MATCHES "Vaughan")
    message(FATAL_ERROR "User-facing product identity must not expose a personal name")
endif()
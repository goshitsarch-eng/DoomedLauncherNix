<component type="desktop-application">
  <id>com.goshapps.DoomLauncher</id>
  <name>Doom Launcher</name>
  <summary>Doom frontend and WAD library for Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="com.goshapps">
    <name>Gosh Apps</name>
  </developer>
  <description>
    <p>
      Doom Launcher is a library for Doom engine games and mods. On Linux it
      uses GTK 4 and libadwaita. It can detect GZDoom as a native binary or
      Flatpak, import IWADs, and download mods from idgames, GitHub, Romero Games,
      and other community sites.
    </p>
  </description>
